---
import site from '../data/site.json';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <h4>{site.name}</h4>
        <p style="color: var(--muted); font-size: 0.9rem;">{site.fullLocation}</p>
      </div>
      <div>
        <h4>Navigasi</h4>
        <ul>
          <li><a href="/">Beranda</a></li>
          <li><a href="/book">Ambil Nomor</a></li>
          <li><a href="/status">Cek Status</a></li>
        </ul>
      </div>
      <div>
        <h4>Area Layanan</h4>
        <div class="area-list">
          {site.areaServed.map((a) => <span class="area-chip">{a}</span>)}
        </div>
        <p style="color: var(--muted); font-size: 0.85rem; margin-top: 1rem;">
          <a href="/admin">Masuk Admin</a>
        </p>
      </div>
    </div>
    <div class="footer-base">
      <span>© {new Date().getFullYear()} {site.name}. Semua hak dilindungi.</span>
      <span>{site.locality} · {site.region}</span>
    </div>
  </div>
</footer>