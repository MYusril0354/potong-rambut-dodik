# Referensi environment (SEKRET server). Salin nilai asli ke .dev.vars (lokal)
# atau set via `npx wrangler secret put <NAMA>` (produksi). JANGAN commit.

# Password login panel admin (fallback dev: "dodik")
ADMIN_PASSWORD=ubah-ini

# Secret penanda cookie admin — pakai string acak 32+ karakter
ADMIN_SECRET=ubah-ini-dengan-string-acak-panjang

# Cloudflare Turnstile (anti-spam form booking) — OPSIONAL
# Site key (publik, waktu build): set di .env / environment build (mis. GitHub secret / [vars])
PUBLIC_TURNSTILE_SITE_KEY=
# Secret key (server, runtime): set via `npx wrangler secret put TURNSTILE_SECRET_KEY`
TURNSTILE_SECRET_KEY=